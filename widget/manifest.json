{
  "author": "csd24",
  "id": "com.csd24.xeneontube",
  "name": "XeneonTube",
  "description": "Browse and watch YouTube on XENEON EDGE. Requires the XeneonTube companion service on this Windows PC.",
  "version": "0.1.0",
  "preview_icon": "resources/icon.svg",
  "min_app_version": "5.52",
  "min_framework_version": "1.9.0",
  "os": [{ "platform": "windows" }],
  "supported_devices": [{ "type": "dashboard_lcd" }],
  "interactive": true,
  "permissions": [
    { "type": "url", "domain": "127.0.0.1", "port": 4173 },
    { "type": "url", "domain": "youtube.com", "port": 443 },
    { "type": "url", "domain": "ytimg.com", "port": 443 },
    { "type": "url", "domain": "googlevideo.com", "port": 443 },
    { "type": "url", "domain": "ggpht.com", "port": 443 },
    { "type": "url", "domain": "google.com", "port": 443 },
    { "type": "url", "domain": "doubleclick.net", "port": 443 },
    { "type": "url", "domain": "googlesyndication.com", "port": 443 },
    { "type": "speaker" }
  ]
}
