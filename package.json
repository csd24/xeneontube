{
  "name": "xeneontube",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.5"
  },
  "scripts": {
    "start": "node --use-env-proxy --env-file-if-exists=.env server.js",
    "test": "node --test",
    "test:browser": "node scripts/check-browser.js",
    "widget:validate": "icuewidget validate widget",
    "widget:package": "node scripts/package-widget.js",
    "prototype:validate": "icuewidget validate prototype",
    "prototype:package": "icuewidget package prototype -o dist/XeneonTube-Direct-Experimental.icuewidget",
    "test:prototype": "node scripts/check-prototype.js"
  },
  "devDependencies": {
    "icuewidget-cli": "0.5.1",
    "playwright-core": "1.64.1"
  }
}
